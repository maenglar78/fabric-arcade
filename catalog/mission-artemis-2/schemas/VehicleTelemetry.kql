// VehicleTelemetry Table Schema
// Stores spacecraft telemetry data during the Artemis 2 mission

.create table VehicleTelemetry (
    EventId: string,
    Timestamp: datetime,
    MissionTime: real,           // Seconds since launch
    Phase: string,               // Pre-Launch, Launch, TLI, Cruise, LunarOrbit, TEI, Re-entry, Splashdown
    Altitude: real,              // km
    Velocity: real,              // km/h
    Acceleration: real,          // G-force
    FuelRemaining: real,         // Percentage
    HullTemperature: real,       // Celsius
    Heading: real,               // Degrees
    DistanceFromEarth: real,     // km
    DistanceFromMoon: real,      // km
    SessionId: string
)

// Enable streaming ingestion
.alter table VehicleTelemetry policy streamingingestion enable

// Create JSON mapping
.create table VehicleTelemetry ingestion json mapping 'VehicleTelemetryMapping'
'['
'    {"column": "EventId", "path": "$.EventId", "datatype": "string"},'
'    {"column": "Timestamp", "path": "$.Timestamp", "datatype": "datetime"},'
'    {"column": "MissionTime", "path": "$.MissionTime", "datatype": "real"},'
'    {"column": "Phase", "path": "$.Phase", "datatype": "string"},'
'    {"column": "Altitude", "path": "$.Altitude", "datatype": "real"},'
'    {"column": "Velocity", "path": "$.Velocity", "datatype": "real"},'
'    {"column": "Acceleration", "path": "$.Acceleration", "datatype": "real"},'
'    {"column": "FuelRemaining", "path": "$.FuelRemaining", "datatype": "real"},'
'    {"column": "HullTemperature", "path": "$.HullTemperature", "datatype": "real"},'
'    {"column": "Heading", "path": "$.Heading", "datatype": "real"},'
'    {"column": "DistanceFromEarth", "path": "$.DistanceFromEarth", "datatype": "real"},'
'    {"column": "DistanceFromMoon", "path": "$.DistanceFromMoon", "datatype": "real"},'
'    {"column": "SessionId", "path": "$.SessionId", "datatype": "string"}'
']'
