// CrewVitals Table Schema
// Stores astronaut vital signs during the Artemis 2 mission

.create table CrewVitals (
    EventId: string,
    Timestamp: datetime,
    MissionTime: real,           // Seconds since launch
    CrewId: string,              // CMD, PLT, MS1, MS2
    CrewName: string,            // Commander Reid, Pilot Hansen, etc.
    HeartRate: int,              // BPM
    BloodPressureSystolic: int,  // mmHg
    BloodPressureDiastolic: int, // mmHg
    OxygenSaturation: real,      // Percentage
    BodyTemperature: real,       // Celsius
    RespirationRate: int,        // Breaths per minute
    StressLevel: string,         // Low, Normal, Elevated, High
    SessionId: string
)

// Enable streaming ingestion
.alter table CrewVitals policy streamingingestion enable

// Create JSON mapping
.create table CrewVitals ingestion json mapping 'CrewVitalsMapping'
'['
'    {"column": "EventId", "path": "$.EventId", "datatype": "string"},'
'    {"column": "Timestamp", "path": "$.Timestamp", "datatype": "datetime"},'
'    {"column": "MissionTime", "path": "$.MissionTime", "datatype": "real"},'
'    {"column": "CrewId", "path": "$.CrewId", "datatype": "string"},'
'    {"column": "CrewName", "path": "$.CrewName", "datatype": "string"},'
'    {"column": "HeartRate", "path": "$.HeartRate", "datatype": "int"},'
'    {"column": "BloodPressureSystolic", "path": "$.BloodPressureSystolic", "datatype": "int"},'
'    {"column": "BloodPressureDiastolic", "path": "$.BloodPressureDiastolic", "datatype": "int"},'
'    {"column": "OxygenSaturation", "path": "$.OxygenSaturation", "datatype": "real"},'
'    {"column": "BodyTemperature", "path": "$.BodyTemperature", "datatype": "real"},'
'    {"column": "RespirationRate", "path": "$.RespirationRate", "datatype": "int"},'
'    {"column": "StressLevel", "path": "$.StressLevel", "datatype": "string"},'
'    {"column": "SessionId", "path": "$.SessionId", "datatype": "string"}'
']'
