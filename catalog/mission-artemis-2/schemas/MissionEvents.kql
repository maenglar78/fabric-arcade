// MissionEvents Table Schema
// Stores discrete mission events during the Artemis 2 mission

.create table MissionEvents (
    EventId: string,
    Timestamp: datetime,
    MissionTime: real,           // Seconds since launch
    EventType: string,           // PhaseChange, Milestone, Alert, Communication
    EventName: string,           // e.g., "Main Engine Cutoff", "TLI Burn Start"
    Description: string,
    Severity: string,            // Info, Warning, Critical
    Phase: string,               // Current mission phase
    Source: string,              // FlightControl, Spacecraft, Crew, Ground
    SessionId: string
)

// Enable streaming ingestion
.alter table MissionEvents policy streamingingestion enable

// Create JSON mapping
.create table MissionEvents ingestion json mapping 'MissionEventsMapping'
'['
'    {"column": "EventId", "path": "$.EventId", "datatype": "string"},'
'    {"column": "Timestamp", "path": "$.Timestamp", "datatype": "datetime"},'
'    {"column": "MissionTime", "path": "$.MissionTime", "datatype": "real"},'
'    {"column": "EventType", "path": "$.EventType", "datatype": "string"},'
'    {"column": "EventName", "path": "$.EventName", "datatype": "string"},'
'    {"column": "Description", "path": "$.Description", "datatype": "string"},'
'    {"column": "Severity", "path": "$.Severity", "datatype": "string"},'
'    {"column": "Phase", "path": "$.Phase", "datatype": "string"},'
'    {"column": "Source", "path": "$.Source", "datatype": "string"},'
'    {"column": "SessionId", "path": "$.SessionId", "datatype": "string"}'
']'
