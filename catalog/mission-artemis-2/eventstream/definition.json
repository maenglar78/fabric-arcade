{
    "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/eventstream/1.0.0/schema.json",
    "sources": [
        {
            "id": "mission-telemetry-source",
            "type": "CustomEndpoint",
            "name": "MissionTelemetryEndpoint",
            "properties": {
                "dataFormat": "Json"
            }
        }
    ],
    "operators": [],
    "destinations": [
        {
            "id": "vehicle-destination",
            "type": "KQLDatabase",
            "name": "VehicleTelemetryDestination",
            "properties": {
                "databaseName": "MissionData",
                "tableName": "VehicleTelemetry",
                "inputDataFormat": "Json",
                "mappingName": "VehicleTelemetryMapping"
            }
        },
        {
            "id": "crew-destination",
            "type": "KQLDatabase",
            "name": "CrewVitalsDestination",
            "properties": {
                "databaseName": "MissionData",
                "tableName": "CrewVitals",
                "inputDataFormat": "Json",
                "mappingName": "CrewVitalsMapping"
            }
        },
        {
            "id": "env-destination",
            "type": "KQLDatabase",
            "name": "EnvironmentalDestination",
            "properties": {
                "databaseName": "MissionData",
                "tableName": "EnvironmentalConditions",
                "inputDataFormat": "Json",
                "mappingName": "EnvironmentalConditionsMapping"
            }
        },
        {
            "id": "events-destination",
            "type": "KQLDatabase",
            "name": "MissionEventsDestination",
            "properties": {
                "databaseName": "MissionData",
                "tableName": "MissionEvents",
                "inputDataFormat": "Json",
                "mappingName": "MissionEventsMapping"
            }
        }
    ],
    "streams": [
        {
            "id": "stream-vehicle",
            "sourceId": "mission-telemetry-source",
            "destinationId": "vehicle-destination",
            "filter": "_eventType == 'VehicleTelemetry'"
        },
        {
            "id": "stream-crew",
            "sourceId": "mission-telemetry-source",
            "destinationId": "crew-destination",
            "filter": "_eventType == 'CrewVitals'"
        },
        {
            "id": "stream-env",
            "sourceId": "mission-telemetry-source",
            "destinationId": "env-destination",
            "filter": "_eventType == 'EnvironmentalConditions'"
        },
        {
            "id": "stream-events",
            "sourceId": "mission-telemetry-source",
            "destinationId": "events-destination",
            "filter": "_eventType == 'MissionEvents'"
        }
    ]
}
