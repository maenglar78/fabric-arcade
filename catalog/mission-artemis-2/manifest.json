{
    "$schema": "https://arcade.fabric.example.com/schemas/game-manifest-v1.json",
    "id": "mission-artemis-2",
    "name": "Mission Artemis 2",
    "version": "1.0.0",
    "description": "Lunar mission with 4 astronauts. Pixel art video synced with real-time telemetry: acceleration, pressure, heart rate, flight phases.",
    "type": "mission",
    "workloads": ["RTI", "DE"],
    "difficulty": 3,
    "duration_minutes": 45,
    "icon": "🚀",
    "tags": ["space", "telemetry", "video-sync", "astronauts"],
    "author": {
        "name": "Fabric Gaming Community"
    },
    "prerequisites": {
        "fabric_capacity": "F2",
        "python_packages": ["requests", "numpy"],
        "skills": ["Basic Python", "KQL fundamentals"]
    },
    "learning_objectives": [
        "Sync real-time telemetry with video playback",
        "Create KQL schemas for multi-type data (vehicle, crew, environment)",
        "Build real-time dashboard for mission control",
        "Handle discrete events (mission phases) and continuous telemetry",
        "Monitor crew vital signs"
    ],
    "achievements": [
        {
            "id": "first-launch",
            "name": "First Launch",
            "description": "Deploy mission and start streaming",
            "icon": "🚀"
        },
        {
            "id": "lunar-orbit",
            "name": "Lunar Orbit",
            "description": "Reach lunar orbit (video 2:00)",
            "icon": "🌙"
        },
        {
            "id": "splashdown",
            "name": "Splashdown",
            "description": "Complete mission with safe splashdown",
            "icon": "🌊"
        }
    ],
    "crew": [
        {"id": "CMD", "name": "Commander Reid", "emoji": "👱", "role": "Commander"},
        {"id": "PLT", "name": "Pilot Hansen", "emoji": "🧍", "role": "Pilot"},
        {"id": "MS1", "name": "Specialist Torres", "emoji": "💪", "role": "Mission Specialist"},
        {"id": "MS2", "name": "Engineer Kim", "emoji": "🧑", "role": "Flight Engineer"}
    ],
    "mission_phases": [
        {"name": "Pre-Launch", "video_start": 0, "video_end": 30},
        {"name": "Launch", "video_start": 30, "video_end": 60},
        {"name": "TLI", "video_start": 60, "video_end": 90},
        {"name": "Cruise", "video_start": 90, "video_end": 120},
        {"name": "Lunar Orbit", "video_start": 120, "video_end": 180},
        {"name": "TEI", "video_start": 180, "video_end": 210},
        {"name": "Re-entry", "video_start": 210, "video_end": 230},
        {"name": "Splashdown", "video_start": 230, "video_end": 240}
    ],
    "items": [
        {
            "type": "Eventhouse",
            "name": "ArtemisEventhouse",
            "description": "KQL engine for mission telemetry"
        },
        {
            "type": "KQLDatabase",
            "name": "MissionData",
            "parent": "ArtemisEventhouse",
            "description": "Database with 4 tables: VehicleTelemetry, CrewVitals, EnvironmentalConditions, MissionEvents"
        },
        {
            "type": "Eventstream",
            "name": "ArtemisStream",
            "definition": "eventstream/definition.json",
            "description": "Real-time data pipeline for mission telemetry"
        },
        {
            "type": "Notebook",
            "name": "Artemis_Simulator",
            "file": "notebooks/artemis_simulator.ipynb",
            "description": "Telemetry simulator synced with 4-minute video"
        },
        {
            "type": "Notebook",
            "name": "Mission_Control",
            "file": "notebooks/mission_control.ipynb",
            "description": "Real-time mission control dashboard"
        }
    ],
    "tables": [
        {
            "name": "VehicleTelemetry",
            "database": "MissionData",
            "schema": "schemas/VehicleTelemetry.kql"
        },
        {
            "name": "CrewVitals",
            "database": "MissionData",
            "schema": "schemas/CrewVitals.kql"
        },
        {
            "name": "EnvironmentalConditions",
            "database": "MissionData",
            "schema": "schemas/EnvironmentalConditions.kql"
        },
        {
            "name": "MissionEvents",
            "database": "MissionData",
            "schema": "schemas/MissionEvents.kql"
        }
    ],
    "story": {
        "intro": "It's 2026. The Artemis 2 mission is about to launch from Cape Canaveral with 4 astronauts aboard. Build the real-time telemetry system that will keep them safe during the journey to the Moon and back.",
        "chapters": [
            {
                "title": "Chapter 1: Mission Prep",
                "description": "Create Eventhouse and KQL Database with schemas for telemetry, vitals, environment"
            },
            {
                "title": "Chapter 2: Launch",
                "description": "Start the simulator synced with the 4-minute video"
            },
            {
                "title": "Chapter 3: In-Flight",
                "description": "Monitor crew and vehicle during lunar orbit"
            },
            {
                "title": "Chapter 4: Splashdown",
                "description": "Manage re-entry and splashdown with real-time dashboard"
            }
        ]
    },
    "video": {
        "duration_seconds": 240,
        "style": "pixel-art",
        "url": "assets/artemis2_mission.mp4"
    }
}
