{
    "$schema": "https://arcade.fabric.example.com/schemas/game-manifest-v1.json",
    "id": "fabric-racing-game",
    "name": "Fabric Racing Game - Championship Edition",
    "version": "2.0.0",
    "description": "🏎️ Race through 10 challenging tracks! Collect ⭐ stars for bonus points, avoid 🚧 obstacles, and climb the leaderboard. Features consecutive multipliers up to x10!",
    "type": "mission",
    "workloads": ["RTI"],
    "difficulty": 2,
    "duration_minutes": 45,
    "icon": "🏎️",
    "tags": ["racing", "arcade", "html5", "streaming", "gaming", "leaderboard"],
    "author": {
        "name": "Fabric Gaming Community"
    },
    "prerequisites": {
        "fabric_capacity": "F2",
        "python_packages": [],
        "skills": ["HTML5 basics", "KQL basics"]
    },
    "learning_objectives": [
        "Create Custom Endpoints in Eventstream",
        "Configure JSON mapping for KQL ingestion",
        "Integrate HTML5 games in Fabric Notebooks",
        "Build real-time dashboards with KQL",
        "Analyze player performance with time-series queries"
    ],
    "features": {
        "levels": 10,
        "tracks": [
            { "level": 1, "name": "Rookie Circuit", "targetScore": 1000, "stars": 5, "obstacles": 3 },
            { "level": 2, "name": "Coastal Road", "targetScore": 2000, "stars": 7, "obstacles": 5 },
            { "level": 3, "name": "Mountain Pass", "targetScore": 3500, "stars": 8, "obstacles": 7 },
            { "level": 4, "name": "Desert Storm", "targetScore": 5000, "stars": 10, "obstacles": 9 },
            { "level": 5, "name": "Night City", "targetScore": 7000, "stars": 12, "obstacles": 12 },
            { "level": 6, "name": "Arctic Ice", "targetScore": 9500, "stars": 14, "obstacles": 15 },
            { "level": 7, "name": "Volcano Ring", "targetScore": 12500, "stars": 16, "obstacles": 18 },
            { "level": 8, "name": "Sky Highway", "targetScore": 16000, "stars": 18, "obstacles": 22 },
            { "level": 9, "name": "Quantum Loop", "targetScore": 20000, "stars": 20, "obstacles": 26 },
            { "level": 10, "name": "Champion's Road", "targetScore": 25000, "stars": 25, "obstacles": 30 }
        ],
        "scoring": {
            "starBonus": 100,
            "consecutiveMultiplier": "x2 to x10",
            "obstaclePenalty": -50,
            "lapBonus": 500,
            "timeBonus": "up to +1800"
        }
    },
    "achievements": [
        {
            "id": "first-start",
            "name": "First Start",
            "description": "Complete your first race",
            "icon": "🏁"
        },
        {
            "id": "star-collector",
            "name": "Star Collector",
            "description": "Collect 50 stars total",
            "icon": "⭐"
        },
        {
            "id": "combo-master",
            "name": "Combo Master",
            "description": "Reach x10 multiplier",
            "icon": "🔥"
        },
        {
            "id": "speed-demon",
            "name": "Speed Demon",
            "description": "Complete a level without hitting obstacles",
            "icon": "⚡"
        },
        {
            "id": "champion",
            "name": "Champion",
            "description": "Complete all 10 levels",
            "icon": "🏆"
        }
    ],
    "items": [
        {
            "type": "Eventhouse",
            "name": "RacingEventhouse",
            "description": "KQL engine for real-time race analytics"
        },
        {
            "type": "KQLDatabase",
            "name": "RaceData",
            "parent": "RacingEventhouse",
            "description": "Database with GameEvents table for scoring telemetry"
        },
        {
            "type": "Eventstream",
            "name": "RacingStream",
            "definition": "eventstream/definition.json",
            "description": "Custom Endpoint → Eventhouse for race events"
        },
        {
            "type": "Notebook",
            "name": "Racing_Championship",
            "file": "notebooks/racing_game_v2.ipynb",
            "description": "🏎️ Championship Edition - 10 tracks, stars, obstacles, leaderboard!"
        },
        {
            "type": "Notebook",
            "name": "Race_Dashboard",
            "file": "notebooks/race_dashboard.ipynb",
            "description": "Real-time KQL dashboard for race analytics"
        }
    ],
    "tables": [
        {
            "name": "GameEvents",
            "database": "RaceData",
            "schema": "schemas/GameEvents.kql",
            "columns": [
                "EventId", "Timestamp", "SessionId", "PlayerId", "EventType",
                "Level", "Score", "Multiplier", "StarsCollected", "Lap",
                "PositionX", "PositionY", "Speed"
            ]
        }
    ],
    "eventTypes": [
        { "name": "RaceStart", "description": "Player starts a race" },
        { "name": "Telemetry", "description": "Periodic position/score update" },
        { "name": "StarCollected", "description": "Player collected a star bonus" },
        { "name": "ObstacleHit", "description": "Player hit an obstacle" },
        { "name": "LapComplete", "description": "Player completed a lap" },
        { "name": "LevelComplete", "description": "Player finished the level" }
    ],
    "story": {
        "intro": "Welcome to the Fabric Racing Championship! Race through 10 unique tracks, collect stars for points, and avoid obstacles. Build the RTI infrastructure that powers the competition!",
        "chapters": [
            {
                "title": "Qualifying",
                "description": "Setup KQL Database with GameEvents table"
            },
            {
                "title": "First Race",
                "description": "Configure Eventstream with Custom Endpoint"
            },
            {
                "title": "Championship",
                "description": "Complete all 10 tracks and climb the leaderboard"
            },
            {
                "title": "Victory Lap",
                "description": "Analyze your performance with KQL dashboards"
            }
        ]
    },
    "post_deploy_steps": [
        "Open RacingStream Eventstream and add Custom Endpoint source",
        "Add KQL Database destination (RacingEventhouse → RaceData → GameEvents)",
        "Publish the Eventstream",
        "Copy the Custom Endpoint URL to the Racing_Championship notebook",
        "Run the notebook and start racing!"
    ]
}
