// GameEvents Table Schema for Fabric Racing Game - Championship Edition
// Creates the table to store all race telemetry events with scoring

.create table GameEvents (
    EventId: string,
    Timestamp: datetime,
    SessionId: string,
    PlayerId: string,
    EventType: string,
    Level: int,
    LevelName: string,
    Score: int,
    TotalScore: int,
    Lives: int,
    Multiplier: int
)

// Enable streaming ingestion for real-time data
.alter table GameEvents policy streamingingestion enable

// Create JSON mapping for Eventstream ingestion
.create table GameEvents ingestion json mapping 'GameEventsMapping' 
'['
'    {"column": "EventId", "path": "$.EventId", "datatype": "string"},'
'    {"column": "Timestamp", "path": "$.Timestamp", "datatype": "datetime"},'
'    {"column": "SessionId", "path": "$.SessionId", "datatype": "string"},'
'    {"column": "PlayerId", "path": "$.PlayerId", "datatype": "string"},'
'    {"column": "EventType", "path": "$.EventType", "datatype": "string"},'
'    {"column": "Level", "path": "$.Level", "datatype": "int"},'
'    {"column": "LevelName", "path": "$.LevelName", "datatype": "string"},'
'    {"column": "Score", "path": "$.Score", "datatype": "int"},'
'    {"column": "TotalScore", "path": "$.TotalScore", "datatype": "int"},'
'    {"column": "Lives", "path": "$.Lives", "datatype": "int"},'
'    {"column": "Multiplier", "path": "$.Multiplier", "datatype": "int"}'
']'
